msgid "%dd %dh"
msgstr "%dd %dh"

msgid "%dh %dm"
msgstr "%dh %dm"

msgid "%dm"
msgstr "%dm"

msgid "%s remaining"
msgstr "Pozostało %s"

msgid "%s used"
msgstr "Wykorzystano %s"

msgid "%s · stale"
msgstr "%s · nieaktualne"

msgid "%s · updated %s"
msgstr "%s · zaktualizowano %s"

msgid "0 places it before the other icons in the area."
msgstr "0 umieszcza go przed innymi ikonami w obszarze."

msgid "About"
msgstr "O programie"

msgid "Anthropic is currently unavailable."
msgstr "Anthropic jest obecnie niedostępny."

msgid "Anthropic returned an invalid response."
msgstr "Anthropic zwrócił nieprawidłową odpowiedź."

msgid "Appearance"
msgstr "Wygląd"

msgid "Author"
msgstr "Autor"

msgid "Both"
msgstr "Oba"

msgid "Bottom left"
msgstr "Na dole po lewej"

msgid "Bottom right"
msgstr "Na dole po prawej"

msgid "Card only"
msgstr "Tylko karta"

msgid "Card position"
msgstr "Położenie karty"

msgid "Center"
msgstr "Pośrodku"

msgid "Checking…"
msgstr "Sprawdzanie…"

msgid "Choose where to show remaining Claude capacity."
msgstr "Wybierz, gdzie pokazywać pozostały limit Claude."

msgid "Claude %s"
msgstr "Claude %s"

msgid "Claude Code"
msgstr "Claude Code"

msgid "Claude Code could not report usage. Retrying later."
msgstr "Claude Code nie podał użycia. Ponowna próba później."

msgid "Claude Code credentials were not found. Sign in to continue."
msgstr "Nie znaleziono danych logowania Claude Code. Zaloguj się, aby kontynuować."

msgid "Claude plan"
msgstr "Plan Claude"

msgid "Could not open the link."
msgstr "Nie można otworzyć linku."

msgid "Credits"
msgstr "Podziękowania"

msgid "Forked from Claudeland by %s"
msgstr "Fork projektu Claudeland autorstwa %s"

msgid "License"
msgstr "Licencja"

msgid "Project"
msgstr "Projekt"

msgid "Report an issue"
msgstr "Zgłoś problem"

msgid "Source code"
msgstr "Kod źródłowy"

msgid "Support development"
msgstr "Wesprzyj rozwój"

msgid "Unofficial and not affiliated with Anthropic."
msgstr "Nieoficjalny i niezwiązany z Anthropic."

msgid "Version %s"
msgstr "Wersja %s"

msgid "Vibecheck"
msgstr "Vibecheck"

msgid "Color"
msgstr "Kolorowa"

msgid "Contributing to usage on this machine"
msgstr "Co wpływa na użycie na tym komputerze"

msgid "Corner of the primary monitor."
msgstr "Róg głównego monitora."

msgid "Could not reach Anthropic. Check your connection."
msgstr "Nie można połączyć się z Anthropic. Sprawdź połączenie."

msgid "Critical remaining capacity"
msgstr "Krytyczny pozostały limit"

msgid "Current session"
msgstr "Bieżąca sesja"

msgid "Data source"
msgstr "Źródło danych"

msgid "Data unavailable"
msgstr "Dane niedostępne"

msgid "Desktop card"
msgstr "Karta na pulpicie"

msgid "Extra usage"
msgstr "Dodatkowe użycie"

msgid "First panel value"
msgstr "Pierwsza wartość w panelu"

msgid "Hidden"
msgstr "Ukryte"

msgid "Install Claude Code to authenticate."
msgstr "Zainstaluj Claude Code, aby się uwierzytelnić."

msgid "Installed and signed in."
msgstr "Zainstalowany i zalogowany."

msgid "Installed, not signed in."
msgstr "Zainstalowany, niezalogowany."

msgid "Left"
msgstr "Po lewej"

msgid "Loading Claude usage…"
msgstr "Wczytywanie użycia Claude…"

msgid "Loading…"
msgstr "Wczytywanie…"

msgid "Lowest remaining"
msgstr "Najniższy pozostały"

msgid "Menu and card"
msgstr "Menu i karta"

msgid "Menu only"
msgstr "Tylko menu"

msgid "Minutes between usage requests."
msgstr "Minuty między zapytaniami o użycie."

msgid "No compatible terminal was found to start Claude sign-in."
msgstr "Nie znaleziono zgodnego terminala do uruchomienia logowania Claude."

msgid "None"
msgstr "Brak"

msgid "Not installed. Usage is requested directly."
msgstr "Niezainstalowany. Użycie jest pobierane bezpośrednio."

msgid "Open Claude browser sign-in through Claude Code."
msgstr "Otwiera logowanie Claude w przeglądarce przez Claude Code."

msgid "Panel area"
msgstr "Obszar panelu"

msgid "Panel icon"
msgstr "Ikona w panelu"

msgid "Panel indicator"
msgstr "Wskaźnik w panelu"

msgid "Panel position"
msgstr "Pozycja w panelu"

msgid "Part of the top bar that holds the indicator."
msgstr "Część górnego paska, w której znajduje się wskaźnik."

msgid "Preferences"
msgstr "Preferencje"

msgid "Query Anthropic's usage endpoint with Claude Code's credentials instead of running Claude Code."
msgstr "Odpytuje punkt końcowy użycia Anthropic danymi logowania Claude Code zamiast uruchamiać Claude Code."

msgid "Refresh interval"
msgstr "Częstotliwość odświeżania"

msgid "Refresh now"
msgstr "Odśwież teraz"

msgid "Remaining capacity shown first in the top bar."
msgstr "Pozostały limit pokazywany jako pierwszy na górnym pasku."

msgid "Remaining capacity warning"
msgstr "Ostrzeżenie o pozostałym limicie"

msgid "Renewing the Claude session…"
msgstr "Odnawianie sesji Claude…"

msgid "Request usage directly"
msgstr "Pobieraj użycie bezpośrednio"

msgid "reset imminent"
msgstr "reset za chwilę"

msgid "reset unavailable"
msgstr "reset niedostępny"

msgid "resets in %dd %dh"
msgstr "reset za %dd %dh"

msgid "resets in %dh %dm"
msgstr "reset za %dh %dm"

msgid "resets in %dm"
msgstr "reset za %dm"

msgid "Right"
msgstr "Po prawej"

msgid "Second panel value"
msgstr "Druga wartość w panelu"

msgid "Session · %s"
msgstr "Sesja · %s"

msgid "Show a card below application windows. Right-click it to refresh."
msgstr "Pokazuje kartę pod oknami aplikacji. Kliknij ją prawym przyciskiem, aby odświeżyć."

msgid "Show how much is used, as Claude does, instead of how much remains."
msgstr "Pokazuje, ile wykorzystano, tak jak Claude, zamiast ile pozostało."

msgid "Show percentages in the GNOME top bar."
msgstr "Pokazuje procenty na górnym pasku GNOME."

msgid "Show used capacity"
msgstr "Pokazuj wykorzystanie"

msgid "Shown after a slash, or None for a single value."
msgstr "Pokazywana po ukośniku; Brak oznacza jedną wartość."

msgid "Shown after the percentages in the top bar."
msgstr "Pokazywany po procentach na górnym pasku."

msgid "Sign in"
msgstr "Zaloguj"

msgid "Sign in / renew session"
msgstr "Zaloguj / odnów sesję"

msgid "Sign in or renew the session"
msgstr "Zaloguj się lub odnów sesję"

msgid "Sign in to Claude Code to view usage."
msgstr "Zaloguj się do Claude Code, aby zobaczyć użycie."

msgid "Sign-in is handled by the official Claude Code CLI."
msgstr "Logowaniem zajmuje się oficjalne CLI Claude Code."

msgid "Stale data · %s"
msgstr "Nieaktualne dane · %s"

msgid "Mono"
msgstr "Jednokolorowa"

msgid "Mono follows the top bar color."
msgstr "Jednokolorowa przyjmuje kolor górnego paska."

msgid "The Claude Code credentials file is invalid."
msgstr "Plik danych logowania Claude Code jest nieprawidłowy."

msgid "The Claude session could not be renewed automatically. Retrying later."
msgstr "Nie udało się automatycznie odnowić sesji Claude. Ponowna próba później."

msgid "The Claude session has expired. Sign in again."
msgstr "Sesja Claude wygasła. Zaloguj się ponownie."

msgid "The Claude session is no longer valid. Sign in again."
msgstr "Sesja Claude nie jest już ważna. Zaloguj się ponownie."

msgid "The desktop card could not be shown."
msgstr "Nie można wyświetlić karty na pulpicie."

msgid "Time until reset"
msgstr "Czas do resetu"

msgid "Too many requests. Retrying later."
msgstr "Zbyt wiele zapytań. Ponowna próba później."

msgid "Top left"
msgstr "Na górze po lewej"

msgid "Top right"
msgstr "Na górze po prawej"

msgid "Updates and thresholds"
msgstr "Odświeżanie i progi"

msgid "Usage contributors"
msgstr "Co wpływa na użycie"

msgid "Use the critical color below this percentage."
msgstr "Używa koloru krytycznego poniżej tego procentu."

msgid "Use the warning color below this percentage."
msgstr "Używa koloru ostrzegawczego poniżej tego procentu."

msgid "Vibecheck is developed in my free time, mostly by burning through the very limits it tracks. If it saved you from a surprise rate limit, help me keep my Claude subscription paid."
msgstr "Rozwijam Vibecheck w wolnym czasie, głównie zużywając te same limity, które śledzi. Jeśli uchronił cię przed niespodziewanym limitem, pomóż mi opłacić subskrypcję Claude."

msgid "Weekly · %s"
msgstr "Tygodniowy · %s"

msgid "Weekly · all models"
msgstr "Tygodniowy · wszystkie modele"

msgid "What drove usage on this machine over the last day and week, from Claude Code."
msgstr "Co wpływało na użycie na tym komputerze w ostatnim dniu i tygodniu, według Claude Code."

msgid "Model"
msgstr "Model"

msgid "Session start"
msgstr "Rozpoczynanie sesji"

msgid "Start sessions automatically"
msgstr "Rozpoczynaj sesje automatycznie"

msgid "Switch in the panel menu"
msgstr "Przełącznik w menu panelu"

msgid "The five-hour window starts with the first request after the previous one ends."
msgstr "Pięciogodzinne okno zaczyna się od pierwszego zapytania po zakończeniu poprzedniego."

msgid "Turn automatic session start on or off by right-clicking the top bar indicator."
msgstr "Włączaj lub wyłączaj automatyczne rozpoczynanie sesji prawym kliknięciem wskaźnika na górnym pasku."

msgid "Used for the prompt. Haiku uses the least capacity."
msgstr "Używany do zapytania. Haiku zużywa najmniej limitu."

msgid "When no window is running, send a short prompt through Claude Code to start one."
msgstr "Gdy żadne okno nie trwa, wysyłaj krótkie zapytanie przez Claude Code, aby je rozpocząć."

msgid "starts with your next request"
msgstr "zacznie się przy następnym zapytaniu"
