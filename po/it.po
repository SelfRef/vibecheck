msgstr "Verifica in corso…"

msgid "Choose where to show remaining Claude capacity."
msgstr "Scegli dove mostrare la capacità Claude rimanente."

msgid "Claude %s"
msgstr "Claude %s"

msgid "Claude Code"
msgstr "Claude Code"

msgid "Claude Code could not report usage. Retrying later."
msgstr "Claude Code non è riuscito a riportare l'utilizzo. Nuovo tentativo più tardi."

msgid "Claude Code credentials were not found. Sign in to continue."
msgstr "Credenziali Claude Code non trovate. Accedi per continuare."

msgid "Claude plan"
msgstr "Piano Claude"

msgid "Could not open the link."
msgstr "Impossibile aprire il collegamento."

msgid "Credits"
msgstr "Riconoscimenti"

