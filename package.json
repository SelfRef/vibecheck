{
	"name": "vibecheck",
	"version": "1.1.2",
	"description": "GNOME Shell extension for remaining Claude plan usage",
	"type": "module",
	"private": true,
	"license": "MIT",
	"author": "SelfRef",
	"engines": {
		"node": ">=22.12",
		"pnpm": ">=9"
	},
	"packageManager": "pnpm@10.15.0",
	"scripts": {
		"build": "node scripts/build.mjs",
		"check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
		"clean": "node scripts/clean.mjs",
		"dev:install": "node scripts/install.mjs",
		"dev:nested": "node scripts/nested.mjs",
		"format": "prettier --write . && eslint --fix .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"package": "pnpm build && node scripts/pack.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit",
		"verify:gjs": "gjs -m dist/smoke-test.js",
		"verify:session": "gjs -m dist/session-check.js",
		"verify:shell": "bash scripts/verify-shell.sh"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@girs/adw-1": "4.9.0",
		"@girs/gjs": "4.9.0",
		"@girs/gnome-shell": "50.0.4",
		"@girs/gobject-2.0": "4.9.0",
		"@girs/gtk-4.0": "4.9.0",
		"@girs/soup-3.0": "4.9.0",
		"@types/node": "^24.19.2",
		"eslint": "^10.13.0",
		"gettext-parser": "^9.1.1",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^5.0.5"
	}
}
